{
  "name": "archcomposer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:model": "node --experimental-strip-types scripts/emit-model.ts",
    "check": "tsc --noEmit",
    "check:layering": "node --experimental-strip-types scripts/check-layering.ts",
    "verify:output": "node --experimental-strip-types scripts/verify-output.ts",
    "smoke:naming": "node --experimental-strip-types src/domain/naming/smoke.ts",
    "smoke:model": "node --experimental-strip-types src/domain/model/smoke.ts",
    "smoke": "npm run smoke:naming && npm run smoke:model",
    "verify": "npm run check && npm run check:layering && npm run gen:model && npm run verify:output && npm run smoke && npm run smoke:generate && npm run walkthrough && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:redirect": "node --experimental-strip-types scripts/demo-redirect.ts",
    "gen:example": "node --experimental-strip-types scripts/emit-example.ts",
    "walkthrough": "node --experimental-strip-types scripts/walkthrough.ts",
    "llm:proxy": "node scripts/llm-proxy.mjs",
    "smoke:generate": "node --experimental-strip-types scripts/smoke-generate.ts"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
