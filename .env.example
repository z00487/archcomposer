# LLM 代理配置示例
#
# 用法：复制成 .env（或 .env.local），填入真实的 key，然后重启 `npm run dev`。
#   ★ .env 与 .env.local 都在 .gitignore 里，不会被提交。
#   ★ 这里**只放示例值**，真 key 永远不进仓库。
#
# 不填也能用：没有 key 时，界面上的「用大模型生成」会自动回退到离线知识表生成，
# 且 `npm run verify` 依然全绿（回归链不依赖网络）。

# DeepSeek 的 API key（必填，若要使用大模型生成）
DEEPSEEK_API_KEY=sk-在此填入你的key

# 上游端点。默认是 DeepSeek 官方；若用自建网关或其它 OpenAI 兼容服务，改这里。
LLM_UPSTREAM=https://api.deepseek.com/v1/chat/completions

# 默认模型名。deepseek-chat（对话）或 deepseek-reasoner（推理）
LLM_MODEL=deepseek-chat

# 代理监听端口（独立跑 scripts/llm-proxy.mjs 时生效；vite 中间件不需要）
LLM_PROXY_PORT=8787
